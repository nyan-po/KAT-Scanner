# KAT Market Screener - Environment Variables
# Copy this file to .env and fill in your values.
# No paid API keys are required for the MVP.

# Optional: override config file path
# KAT_CONFIG_PATH=config.yaml

# Optional: override output directory
# KAT_OUTPUT_DIR=.

# Optional: set log level (DEBUG, INFO, WARNING, ERROR)
# KAT_LOG_LEVEL=INFO

# Reserved for future paid data integrations (not required for MVP)
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
